{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": {
      "blue": "#0774FF",
      "deep": "#033AA7",
      "sky": "#2D86FF",
      "accent": "#FFC107",
      "ctaAccessible": "#005ECC",
      "successProvisional": "#2DD4A0"
    },
    "text": {
      "main": "#2D3C58",
      "muted": "#4C5671",
      "inverse": "#FFFFFF"
    },
    "surface": {
      "base": "#FFFFFF",
      "tint": "#F3F5FF",
      "tint2": "#E7EBFF"
    },
    "border": {
      "muted": "#DCE6F5"
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "12": 48,
    "16": 64,
    "24": 96
  },
  "radius": {
    "card": 10,
    "field": 10,
    "pill": 999
  },
  "chamfer": {
    "card": 16,
    "sectionLarge": 48
  },
  "font": {
    "heading": "Plus Jakarta Sans",
    "body": "Inter",
    "arabic": "IBM Plex Sans Arabic"
  },
  "icon": {
    "masterSize": 48,
    "minSize": 24,
    "stroke": 2
  },
  "layout": {
    "contentMax": 1200,
    "gutterMobile": 20,
    "gutterDesktop": 32,
    "breakpoints": {
      "small": 480,
      "medium": 768,
      "large": 1024,
      "wide": 1440
    }
  },
  "motion": {
    "microMs": 160,
    "transitionMs": 240,
    "sectionMs": 360,
    "reducedMotion": "disable-decorative-motion"
  },
  "pattern": {
    "tile": 96,
    "stroke": 1.2,
    "maxCoveragePercent": 15,
    "targetOpacityOnBlue": 0.2
  },
  "ux": {
    "targetPointerCSSPixels": 44,
    "focusRingCSSPixels": 3,
    "contrastNormalTextMinimum": 4.5,
    "contrastLargeTextMinimum": 3
  }
}